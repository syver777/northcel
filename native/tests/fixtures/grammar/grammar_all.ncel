northcel "0.2.0-draft"

// Grammar coverage fixture: every 0.2 construct in one small film.
film GrammarAll(width: 320, height: 200, fps: 6, frames: 3, seed: 7, precision: 0.25px-b63) {
  palette { ink: #0D0D0D, sky: #70CCF5, warm: #E08040, paperwhite: 250 }
  paper { color: $sky, antialias_grid: 4, grain: 0.01 }

  // def with defaults + params; stroke taper; per-stroke boil; translate in layer.
  def Stamp(dx: 0, dy = 0, tone: 40) {
    wash stamp_body(tone: 40, rings: 2, translate: (dx, dy)) { "20,40:VWVWfXfXfXfX|120,40:VWVWfXfXfXfX" }
    stroke stamp_edge(color: $warm, taper: (6.0, 1.0), boil: 0.5px) { (20 + dx, 30 + dy), (60 + dx, 34 + dy), (90 + dx, 26 + dy) }
    layer stamp_dot(color: rgb(20, 30, 40), rings: 1, dx: 3, dy: -2) { "10,10 8,0 0,8 -8,0" }
  }

  // def containing a bend_swarm (agent evaluation goes through Bend/HVM2).
  def Drift(dx: 0, dy: 0) {
    bend_swarm rain(color: $warm, agents: 2, boil: (0.4px, 2.0), translate: (dx, dy)) { "20,40 24,16 -8,4 -24,-16|120,40 24,16 -8,4 -24,-16" }
  }

  layer ground(tone: 210, rings: 1) { "0,160 1280,0 0,160 -1280,0" }

  // cel with coupled outline; 2 rings.
  cel bubble(color: $warm, rings: 2, outline: ($ink, 3px)) {
    "40,60 40,0 40,0 0,40 -40,0 -40,0 0,-40|200,60 24,0 24,0 0,24 -24,0 -24,0 0,-24"
  }

  // cel with NO outline attribute (reference quirk: no coupled outline).
  cel plain(color: #445566, rings: 1) { "260,120 30,0 0,30 -30,0 0,-30" }

  // `fill:` alias and `outline:` bare-width form.
  wash fill_alias(fill: $warm, rings: 1, outline: 2px) { "10,120 40,0 0,20 -40,0" }

  // cel with ink_width/ink attribute form.
  cel halo(color: #333333, rings: 1, ink_width: 1.5, ink: $ink) { "100,100 60,0 0,60 -60,0 0,-60" }

  // expression coverage: sin/cos/step, negative constants, mul/add.
  stroke sway(color: $ink, width: 2.5) { (10, 180), (40 + sin(t * 6.28318) * 12, 170 + step(0.5, t) * 4), (70 + cos(t * 3.14159) * 6, 190) }

  // ribbon with per-vertex widths and boil.
  ribbon tail(color: $ink, boil: 0.3px) { (30, 150, step(0.5, 0.5) * 4 + 5), (60, 140, 6), (90, 148, 3), (120 - 4, 138, 7) }

  // swarm alias, no agents attribute on one of them.
  swarm mist(color: #DDDDDD, agents: 3, translate: (6, 0)) { "10,60 8,0 0,8 -8,0|40,80 8,0 0,8 -8,0|70,100 8,0 0,8 -8,0" }

  use Stamp(dx: lerp(0, 30, t), dy: 4)
  use Drift(dx: lerp(-10, 10, t), dy: 0)
  use Stamp(dx: 90, dy: 0)
  use Drift(dx: 0, dy: 0)

  frame 1 {
    paper { color: #F0E0D0, antialias_grid: 4, grain: 0.0 }
    palette { extra: #204060 }
    // drop an inherited layer.
    drop ground
    // in-place replacement of the inherited cel fill (its old outline remains,
    // exactly like the reference renderer's upsert semantics).
    layer bubble(color: #40C0F0, rings: 1) { "150,150 50,0 0,50 -50,0 0,-50" }
    use Stamp(dx: 10, dy: 0, tone: 90)
    layer frame_only(color: $extra, rings: 1) { "0,0 400,0 0,400 -400,0" }
  }

  frame 2 {
    palette { ink: #202020 }
    def FrameExtra(x: 0) {
      layer frame_def(color: #AABBCC, rings: 1, translate: (x, 0)) { "200,20 30,0 0,20 -30,0" }
    }
    use FrameExtra(x: 5)
    layer ground(tone: 180, rings: 1) { "0,120 1280,0 0,240 -1280,0" }
    ribbon extra(color: $ink, boil: 0.2px) { (20, 20, 5), (80, 30, 5), (140, 20, 5) }
    drop tail
    drop bubble__outline
  }
}
