northcel "0.5.0-draft"
scene Semantics(width: 32, height: 32, fps: 1, precision: 0.25px, seed: 1) {
 paper { color: #FFFFFF, antialias_grid: 4, grain: 0 }
 group overlap(opacity: 0.5) {
  layer red(color: #FF0000) { "8,8 48,0 0,48 -48,0" }
  layer blue(color: #0000FF) { "32,8 48,0 0,48 -48,0" }
 }
 layer mask(color: #000000, opacity: 0) { "8,72 72,0 0,48 -72,0|24,88 24,0 0,16 -24,0" }
 group clipped(clip: mask) {
  layer green(color: #00FF00) { "0,64 96,0 0,64 -96,0" }
 }
}
