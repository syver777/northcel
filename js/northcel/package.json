{
  "name": "northcel",
  "version": "0.7.1",
  "description": "NorthCel (.ncel) — the open drawing language for AI-drawn video. This package runs the native MoonBit + Bend/HVM2 + GLSL runtime on Linux x86_64, ships a zero-dependency partial JS pre-check, and says plainly when a platform cannot render natively.",
  "license": "MIT OR Apache-2.0",
  "author": "NorthCel contributors",
  "homepage": "https://github.com/syver777/northcel",
  "repository": {
    "type": "git",
    "url": "https://github.com/syver777/northcel.git",
    "directory": "js/northcel"
  },
  "bugs": {
    "url": "https://github.com/syver777/northcel/issues"
  },
  "bin": {
    "northcel": "bin/northcel.js",
    "ncel": "bin/northcel.js"
  },
  "main": "index.cjs",
  "files": [
    "bin/northcel.js",
    "lib/locate.js",
    "index.cjs",
    "rules.json",
    "northcel/AGENT-GUIDE.md",
    "data/pins.json",
    "data/starter.ncel",
    "data/lantern_film.ncel",
    "data/shower_f0001.ncel",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "optionalDependencies": {
    "northcel-linux-x64": "0.4.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "prepack": "python3 scripts/sync-assets.py --check"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "northcel",
    "ncel",
    "ai-drawn-video",
    "animation",
    "moonbit",
    "bend",
    "hvm2",
    "glsl",
    "dsl"
  ]
}
